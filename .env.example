# Where the LEAD module gets its data from.
#   mock -> in-browser mock services (default, no backend needed)
#   api  -> Express REST API at NEXT_PUBLIC_API_BASE_URL
NEXT_PUBLIC_DATA_SOURCE=mock

# Express API base URL.
# Brands and Locations always use this API, whatever NEXT_PUBLIC_DATA_SOURCE is set to.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Simulated network delay for mock services, in milliseconds
NEXT_PUBLIC_MOCK_LATENCY_MS=250
